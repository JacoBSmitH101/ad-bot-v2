{
  "name": "ad-bot-v2",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord-only darts league bot, rewritten cleanly with proper separation of concerns.\r Runs as a long-lived Node.js service on a Linux VM.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
