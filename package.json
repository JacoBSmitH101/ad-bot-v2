  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "better-docs": "^2.7.3",
    "clean-jsdoc-theme": "^4.3.0",
    "jsdoc": "^4.0.5"
  }
